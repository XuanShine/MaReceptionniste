{"nodes": [{"id": "readme_ma_receptionniste", "label": "Ma R\u00e9ceptionniste", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Application web de r\u00e9ception d'h\u00f4tel. Le d\u00e9veloppement se lance avec rechargement sur http://127.0.0.1:8080 ; sans rechargement, la commande est uv run ma-receptionniste."}, {"id": "readme_sqlmodel", "label": "SQLModel", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Les mod\u00e8les vivent dans models.py. Au d\u00e9marrage, SQLModel.metadata.create_all cr\u00e9e les tables absentes."}, {"id": "readme_uv", "label": "uv", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pr\u00e9requis d'installation et de lancement : uv sync, uv run pour le serveur, pytest et ruff."}, {"id": "readme_libreoffice", "label": "LibreOffice", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pr\u00e9requis pour convertir le mod\u00e8le de facture en PDF."}, {"id": "readme_database_url", "label": "DATABASE_URL", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "D\u00e9faut sqlite:///ma_receptionniste.db. La base de d\u00e9monstration est sqlite:////tmp/demo.db."}, {"id": "readme_storage_secret", "label": "STORAGE_SECRET", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signe les cookies de session. Une valeur de d\u00e9veloppement est fournie et doit \u00eatre d\u00e9finie en production."}, {"id": "readme_host_port", "label": "HOST et PORT", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HOST d\u00e9faut 127.0.0.1, PORT d\u00e9faut 8080."}, {"id": "readme_montants_centimes", "label": "Montants en centimes", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Les montants sont stock\u00e9s en centimes entiers et affich\u00e9s par format_euros : 13764 donne 137,64 \u20ac."}, {"id": "readme_format_euros", "label": "format_euros", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fonction d'affichage des centimes entiers, expos\u00e9e par facturation.py."}, {"id": "readme_taxe_sejour", "label": "Taxe de s\u00e9jour", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TAXE_SEJOUR_CENTIMES vaut 200 : taxe par adulte et par nuit, en centimes. Les enfants en sont exon\u00e9r\u00e9s."}, {"id": "readme_facturation", "label": "Facturation", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "facturation.py calcule les nuits, les montants, la taxe de s\u00e9jour, les totaux, et expose format_euros."}, {"id": "readme_enregistrer_sejour", "label": "enregistrer_sejour", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sejours.py : seule \u00e9criture d'un s\u00e9jour, avec contr\u00f4le des chevauchements."}, {"id": "readme_consultations", "label": "Consultations", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "consultations.py : lectures pr\u00eates \u00e0 afficher (planning, listes, fiche_sejour, statut affich\u00e9)."}, {"id": "readme_saisie", "label": "Saisie journalis\u00e9e", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "saisie.py : \u00e9critures journalis\u00e9es de la fiche, de l'occupant, des lignes et de la facture."}, {"id": "readme_authentification", "label": "Authentification", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "auth.py : hash des mots de passe, inscription, login et middleware."}, {"id": "readme_public_routes", "label": "PUBLIC_ROUTES", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Toutes les pages sauf /login et /register exigent d'\u00eatre connect\u00e9. La liste est PUBLIC_ROUTES dans auth.py."}, {"id": "readme_pages", "label": "Pages", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paquet pages : / (planning), /reservations, /reservations/{id} (fiche s\u00e9jour), /clients, /chambres, /login et /register."}, {"id": "readme_layout", "label": "Layout", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "layout.page(actif, titre) fournit le menu lat\u00e9ral et la barre de titre."}, {"id": "readme_theme", "label": "Th\u00e8me", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "theme.py : palette, police, props par d\u00e9faut et formats de date."}, {"id": "readme_evolution_schema", "label": "\u00c9volution du sch\u00e9ma", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Le d\u00e9marrage cr\u00e9e les tables absentes puis ajoute les colonnes manquantes. Une nouvelle colonne doit \u00eatre nullable ou avoir un server_default. Les renommages, suppressions et changements de type ne sont pas g\u00e9r\u00e9s et demanderont Alembic."}, {"id": "readme_create_db_and_tables", "label": "create_db_and_tables", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cr\u00e9e les tables absentes avec SQLModel.metadata.create_all, puis appelle ajouter_colonnes_manquantes."}, {"id": "readme_ajouter_colonnes_manquantes", "label": "ajouter_colonnes_manquantes", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ajoute par ALTER TABLE \u2026 ADD COLUMN les colonnes du mod\u00e8le absentes d'une table existante."}, {"id": "readme_colonnenonajoutable", "label": "ColonneNonAjoutable", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arr\u00eate le d\u00e9marrage avant toute modification si une nouvelle colonne n'est ni nullable ni munie d'un server_default."}, {"id": "readme_alembic", "label": "Alembic", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Voie pr\u00e9vue pour les renommages, les suppressions et les changements de type de colonne, que l'ajout de colonnes manquantes ne couvre pas."}, {"id": "readme_archives_virtuelles", "label": "Archives des formules virtuelles", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cellule_virtuelle et option_virtuelle sont copi\u00e9es dans archive_cellule_virtuelle et archive_option_virtuelle puis retir\u00e9es dans la m\u00eame transaction. Les archives gardent lignes et formules sans cl\u00e9s \u00e9trang\u00e8res, pour ne pas bloquer le remplacement des types. L'archive des cellules conserve le wubook_id et le libell\u00e9 du type. Les formules ne sont pas converties en prix ni en chambres virtuelles actives. La migration est idempotente ; un conflit de nom d'archive annule la transaction sans \u00e9craser de donn\u00e9es."}, {"id": "readme_import_wubook", "label": "Import des types de chambres Wubook", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WUBOOK_TOKEN et WUBOOK_LCODE sont lus par le client Wubook. Apr\u00e8s confirmation, HandlingRooms.fetch_rooms() remplace le catalogue local : les chambres standard deviennent des types, les virtuelles sont rattach\u00e9es via subroom. Les chambres physiques et leurs s\u00e9jours ne sont pas supprim\u00e9s ; les affectations suivent wubook_id, celles des types disparus sont retir\u00e9es. Un catalogue vide vide le local. Un \u00e9chec de r\u00e9cup\u00e9ration, de validation ou d'insertion ne modifie rien. Aucun changement n'est envoy\u00e9 \u00e0 Wubook. La cr\u00e9ation manuelle de types n'est plus propos\u00e9e."}, {"id": "readme_subroom", "label": "subroom", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lien utilis\u00e9 pour rattacher les chambres virtuelles Wubook aux types import\u00e9s."}, {"id": "readme_anchorate", "label": "anchorate", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parent tarifaire Wubook. Les chambres virtuelles n'y sont pas rattach\u00e9es lors de l'import."}, {"id": "readme_donnees_exemple", "label": "Donn\u00e9es de d\u00e9monstration", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "scripts/donnees_exemple.py est relan\u00e7able : chaque \u00e9tape n'ajoute que ce qui manque. Il cr\u00e9e le compte reception@hotel-panorama.fr (mot de passe panorama), 13 chambres et 16 r\u00e9servations sur Booking.com, Expedia, Direct et T\u00e9l\u00e9phone, autour de la semaine courante."}, {"id": "readme_test_fiche_ui", "label": "Test d'interface fiche", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tests/test_fiche_ui.py utilise la fixture User de NiceGUI, sans navigateur. pyproject.toml charge le plugin -p nicegui.testing.user_plugin et d\u00e9signe main.py comme fichier principal."}, {"id": "readme_main", "label": "D\u00e9marrage", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "main.py est le point d'entr\u00e9e de d\u00e9veloppement avec rechargement. src/ma_receptionniste/__init__.py expose main() : th\u00e8me, pages et d\u00e9marrage NiceGUI. db.py fournit l'engine, la cr\u00e9ation des tables et les sessions."}], "edges": [{"source": "readme_ma_receptionniste", "target": "readme_sq